<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      allowBackup="false": la sesión no debe viajar en un respaldo. Un respaldo
      se restaura en OTRO teléfono, con OTRO Keystore, y ahí el token cifrado es
      basura — y un token en claro sería una sesión regalada.
    -->
    <application
        android:name=".AvisosApplication"
        android:allowBackup="false"
        android:label="Avisos"
        android:supportsRtl="true"
        android:theme="@style/Theme.Avisos">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Avisos">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
